# 阿里云NLS服务配置
ALIYUN_AK_ID=your_access_key_id_here
ALIYUN_AK_SECRET=your_access_key_secret_here

# 或者使用其他变量名
# ALIYUN_ACCESS_KEY_ID=your_access_key_id_here
# ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret_here

# OpenAI配置 (可选)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.moonshot.cn/v1

# TTS配置 (可选)
# TTS_URL=wss://nls-gateway-cn-shanghai.aliyuncs.com/ws/v1
# TTS_APPKEY=your_appkey