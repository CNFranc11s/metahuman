{
  "buildCommand": "cd frontend-react && npm run build && rm -rf ../public/* && cp -r dist/* ../public/",
  "outputDirectory": "public",
  "installCommand": "cd frontend-react && npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
